{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "trailingSlash": false,
  "redirects": [
    { "source": "/achsvermessung", "destination": "/#leistungen", "permanent": true },
    { "source": "/reparaturen", "destination": "/#leistungen", "permanent": true },
    { "source": "/instandhaltung", "destination": "/#leistungen", "permanent": true },
    { "source": "/aufbereitung", "destination": "/leistungen/fahrzeugaufbereitung", "permanent": true },
    { "source": "/reifenwechsel", "destination": "/leistungen/reifen-felgenservice", "permanent": true },
    { "source": "/smart-repair-glas", "destination": "/leistungen/autoglas", "permanent": true },
    { "source": "/reifenlagerung", "destination": "/leistungen/reifen-felgenservice", "permanent": true },
    { "source": "/oelwechsel", "destination": "/leistungen/oelwechsel", "permanent": true },
    { "source": "/tuev", "destination": "/leistungen/hu-au", "permanent": true },
    { "source": "/tuv", "destination": "/leistungen/hu-au", "permanent": true },
    { "source": "/termin", "destination": "/kontakt#anfrage", "permanent": false },
    { "source": "/whatsapp", "destination": "/kontakt", "permanent": false },
    { "source": "/leistungen", "destination": "/#leistungen", "permanent": true },
    { "source": "/leistungen/achsvermessung", "destination": "/#leistungen", "permanent": true },
    { "source": "/leistungen/reparaturen", "destination": "/#leistungen", "permanent": true },
    { "source": "/leistungen/instandhaltung", "destination": "/#leistungen", "permanent": true },
    { "source": "/leistungen/aufbereitung", "destination": "/leistungen/fahrzeugaufbereitung", "permanent": true },
    { "source": "/leistungen/reifenwechsel", "destination": "/leistungen/reifen-felgenservice", "permanent": true },
    { "source": "/leistungen/smart-repair-glas", "destination": "/leistungen/autoglas", "permanent": true },
    { "source": "/leistungen/reifenlagerung", "destination": "/leistungen/reifen-felgenservice", "permanent": true },
    { "source": "/leistungen/tuev", "destination": "/leistungen/hu-au", "permanent": true },
    { "source": "/faq", "destination": "/#fragen", "permanent": true },
    { "source": "/blog/winterreifen-alpine-symbol-was-jetzt-gilt", "destination": "/leistungen/reifen-felgenservice", "permanent": true },
    { "source": "/blog/oelwechsel-intervall-freigabe-richtiges-motoroel", "destination": "/leistungen/oelwechsel", "permanent": true },
    { "source": "/blog/tuev-checkliste-hauptuntersuchung-bestehen", "destination": "/leistungen/hu-au", "permanent": true },
    { "source": "/blog/steinschlag-reparieren-oder-scheibe-tauschen", "destination": "/leistungen/autoglas", "permanent": true },
    { "source": "/blog/fahrzeugaufbereitung-werterhalt-verkauf-leasing", "destination": "/leistungen/fahrzeugaufbereitung", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://vercel.live https://vercel.com; font-src 'self' data:; connect-src 'self' https://vercel.live wss://ws-us3.pusher.com; frame-src https://vercel.live https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
