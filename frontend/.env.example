# ─────────────────────────────────────────────────────────────
# PKW Schmiede – Umgebungsvariablen
# Lokal: Datei nach .env.local kopieren. Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (ohne abschließenden Slash) – für Canonical, Sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.pkw-schmiede.de

# Resend API-Key (https://resend.com/api-keys) – Berechtigung "Sending access" genügt
# Echter Key NUR in .env.local und in Vercel – diese Datei wird committet.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# Empfänger: Ihr IONOS-Postfach, in dem die Anfragen landen
CONTACT_TO_EMAIL=kontakt@pkw-schmiede.de

# Absender: Adresse auf der in Resend verifizierten Domain (DNS-Einträge bei IONOS setzen) – braucht kein eigenes Postfach
CONTACT_FROM_EMAIL="PKW Schmiede Website <formular@pkw-schmiede.de>"
