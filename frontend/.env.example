# ─────────────────────────────────────────────────────────────
# Sercans PKW Schmiede – Umgebungsvariablen
# Lokal: Datei nach .env.local kopieren. Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (ohne abschließenden Slash) – für Canonical, Sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.XXX.de

# Resend API-Key (https://resend.com/api-keys) – Berechtigung "Sending access" genügt
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# Empfänger: Ihr IONOS-Postfach, in dem die Anfragen landen
CONTACT_TO_EMAIL=info@XXX.de

# Absender: Adresse auf der in Resend verifizierten Domain (DNS-Einträge bei IONOS setzen)
CONTACT_FROM_EMAIL="Sercans PKW Schmiede <kontakt@XXX.de>"
